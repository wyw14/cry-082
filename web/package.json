{
  "name": "cry-082-web",
  "private": true,
  "version": "1.0.0",
  "description": "Offline operations console for construction-site dust monitoring",
  "type": "module",
  "engines": {
    "node": ">=20.11",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run --reporter=verbose",
    "check": "npm run typecheck && npm run test:ci && npm run build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.9.6",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.7",
    "vue-tsc": "^2.2.8"
  }
}
